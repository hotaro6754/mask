# DEVELOPMENT settings (synthetic demo data). For production see deploy/production.env.example and docs/DEPLOYMENT.md.
# Copy to .env (never commit .env) and export before running, e.g.  set -a; source .env; set +a
# Windows PowerShell:  Get-Content .env | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { Set-Item "env:$($matches[1])" $matches[2] } }

# Database: sqlite:///data/bank.db | postgresql://user:pw@host:5432/bank | mysql://user:pw@host:3306/bank
MASKGUARD_DB=sqlite:///data/bank.db

# Required. Key for analyst HMAC tokens: at least 16 random bytes, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`
MASKGUARD_HMAC_KEY=
# Recommended. Signs session tokens; without it tokens are invalidated on every restart.
MASKGUARD_JWT_SECRET=

# development (default) | production. Any other value is refused. Production refuses to start unless the user store,
# secrets, database account and network settings are safe (docs/DEPLOYMENT.md).
MASKGUARD_ENV=development
# 1 = one-click demo identities (admin.ann, support.sam, analyst.ali, auditor.aud). Never in production.
MASKGUARD_DEMO=1

MASKGUARD_POLICY=policies/default.yaml
MASKGUARD_USERS=policies/users.demo.yaml
MASKGUARD_OVERRIDES=policies/overrides.yaml
MASKGUARD_AUDIT=data/audit.jsonl
MASKGUARD_REGISTRY=data/registry.yaml
MASKGUARD_SCAN_INTERVAL=300

# CLI only: talk to a running API instead of the in-process engine
# MASKGUARD_API=http://127.0.0.1:8000
