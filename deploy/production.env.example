# Settings for docker-compose.prod.yml. Copy to deploy/production.env, fill in EVERY value, keep the copy out of
# version control (.gitignore covers it). Empty values count as missing: Compose and MaskGuard both refuse to start.
#
# Generate each secret separately, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
# Use hex (or other URL-safe) database passwords: they are placed inside connection URLs.

# Analyst HMAC tokens (>= 32 characters). Changing it changes every token.
MASKGUARD_HMAC_KEY=
# Signs session tokens (>= 32 characters). Must be stable across restarts and shared by all instances.
MASKGUARD_JWT_SECRET=
# Database owner (owns the tables; used by the db-install job and your data loads, never by the gateway)
MASKGUARD_DB_OWNER_PASSWORD=
# The gateway's read-only database login (maskguard_gateway)
MASKGUARD_GATEWAY_DB_PASSWORD=

# Files on the host (absolute paths, or relative to the repository root)
MASKGUARD_USERS_FILE=           # your user store, see deploy/users.example.yaml and `maskguard hash-password`
MASKGUARD_TLS_CERT_FILE=        # PEM certificate (chain) for the HTTPS API
MASKGUARD_TLS_KEY_FILE=         # PEM private key

# Host address the HTTPS port (8443) is published on: 127.0.0.1 = this machine only, 0.0.0.0 = every interface.
MASKGUARD_PUBLISH_ADDR=127.0.0.1
