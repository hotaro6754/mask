{
  "info": {
    "name": "MaskGuard API",
    "description": "Role-based masking demo: log in as each role, run the same query, compare. Run the whole collection with the Collection Runner; every request has assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "supportToken",
      "value": ""
    },
    {
      "key": "analystToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Log in",
      "item": [
        {
          "name": "Log in as admin.ann",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin.ann\",\n  \"password\": \"admin123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login ok', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in as support.sam",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"support.sam\",\n  \"password\": \"support123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login ok', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('supportToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in as analyst.ali",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"analyst.ali\",\n  \"password\": \"analyst123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login ok', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('analystToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong password is refused",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"support.sam\",\n  \"password\": \"nope\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Same query, three roles",
      "item": [
        {
          "name": "Admin sees real values",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/query",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "query"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sql\": \"SELECT u.name, u.ssn, a.credit_card, a.balance FROM users u JOIN accounts a ON a.user_id = u.id ORDER BY u.id LIMIT 3\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('no masking', () => pm.expect(pm.response.json().masked).to.eql([]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Support sees partial masks",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/query",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "query"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sql\": \"SELECT u.name, u.ssn, a.credit_card, a.balance FROM users u JOIN accounts a ON a.user_id = u.id ORDER BY u.id LIMIT 3\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{supportToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('ssn partially masked', () => pm.expect(r.rows[0][1]).to.match(/^XXX-XX-\\d{4}$/));",
                  "pm.test('card masked', () => pm.expect(r.rows[0][2]).to.include('X'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Analyst sees tokens and redaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/query",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "query"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sql\": \"SELECT u.name, u.ssn, a.credit_card, a.balance FROM users u JOIN accounts a ON a.user_id = u.id ORDER BY u.id LIMIT 3\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{analystToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('name redacted', () => pm.expect(r.rows[0][0]).to.eql('REDACTED'));",
                  "pm.test('ssn is a 16-char token', () => pm.expect(r.rows[0][1]).to.have.lengthOf(16));"
                ]
              }
            }
          ]
        },
        {
          "name": "Analyst: differentially private average",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/query",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "query"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sql\": \"SELECT status, avg(balance) FROM accounts GROUP BY status\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{analystToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('privacy budget charged', () => pm.expect(pm.response.json().dp.epsilon).to.be.above(0));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Attacks",
      "item": [
        {
          "name": "Alias trick is still masked",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/query",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "query"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sql\": \"SELECT ssn AS x FROM users LIMIT 1\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{supportToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('masked', () => pm.expect(pm.response.json().rows[0][0]).to.match(/^XXX-XX-/));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter on a masked value learns nothing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/query",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "query"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sql\": \"SELECT id FROM users WHERE ssn LIKE '2%'\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{supportToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('no rows', () => pm.expect(pm.response.json().row_count).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "DROP TABLE is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/query",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "query"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sql\": \"DROP TABLE users\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{supportToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Attack suite for my role",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/attacks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "attacks"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{analystToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('zero leaks', () => pm.expect(pm.response.json().score.maskguard_leaks).to.eql(0));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Admin",
      "item": [
        {
          "name": "PII scanner tags",
          "request": {
            "method": "GET",
            "header": [
