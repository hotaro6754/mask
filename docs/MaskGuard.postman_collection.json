            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('tags present', () => pm.expect(pm.response.json().tagged.length).to.be.above(5));"
                ]
              }
            }
          ]
        },
        {
          "name": "Table checksums (data untouched)",
          "request": {
            "method": "GET",
            "header": [
